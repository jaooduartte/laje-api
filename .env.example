NODE_ENV=development
PORT=3000

# Obrigatório. Informe uma instância PostgreSQL 17 acessível ao ambiente de execução.
# Não use credenciais reais de staging/produção em arquivos versionados.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SHUTDOWN_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:8080

# Ative somente depois de aplicar a migration LAJE-85 e preparar as credenciais administrativas.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN_DAYS=30

AWS_ENABLED=false
AWS_REGION=sa-east-1
AWS_SECRETS_PREFIX=laje/development

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
